# Copy to untracked .env.local only if overriding the documented defaults.
# Keep this origin aligned with the local server port used for a demonstration.
WATCHNEXT_APP_ORIGIN=http://127.0.0.1:3000

# Optional local storage override; unset uses the OS-local user-data directory.
# WATCHNEXT_DATABASE_PATH=C:/Users/your-name/AppData/Local/WatchNext/watchnext.sqlite

# Optional server-only YouTube Data API v3 key. Leave unset for manual entry.
# YOUTUBE_API_KEY=
